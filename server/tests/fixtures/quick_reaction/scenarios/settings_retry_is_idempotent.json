{
  "name": "settings_retry_is_idempotent",
  "description": "A retry of a PUT that already took effect (lost response) answers 200 with the stored settings and does not bump the revision.",
  "setup": {
    "emoji": {
      "blobcat": {
        "shortcode": "blobcat",
        "image_url": "https://emoji.shuttlepub.example/blobcat.png",
        "availability": "available"
      },
      "oldcat": {
        "shortcode": "oldcat",
        "availability": "unavailable",
        "reason": "deleted"
      },
      "offcat": {
        "shortcode": "offcat",
        "availability": "unavailable",
        "reason": "disabled"
      }
    },
    "settings": {
      "revision": 0,
      "favorites": []
    },
    "reaction": null
  },
  "steps": [
    {
      "operation": "putQuickReactionSettings",
      "body": {
        "expected_revision": 0,
        "favorites": [
          {
            "type": "unicode",
            "value": "👍"
          },
          {
            "type": "unicode",
            "value": "❤️"
          }
        ]
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": 1,
          "favorites": [
            {
              "emoji": {
                "type": "unicode",
                "value": "👍"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "❤️"
              },
              "availability": "available"
            }
          ]
        }
      }
    },
    {
      "operation": "putQuickReactionSettings",
      "body": {
        "expected_revision": 0,
        "favorites": [
          {
            "type": "unicode",
            "value": "👍"
          },
          {
            "type": "unicode",
            "value": "❤️"
          }
        ]
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": 1,
          "favorites": [
            {
              "emoji": {
                "type": "unicode",
                "value": "👍"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "❤️"
              },
              "availability": "available"
            }
          ]
        }
      },
      "note": "identical retry with the stale expected_revision"
    },
    {
      "operation": "putQuickReactionSettings",
      "body": {
        "expected_revision": 1,
        "favorites": [
          {
            "type": "unicode",
            "value": "👍"
          },
          {
            "type": "unicode",
            "value": "❤️"
          }
        ]
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": 1,
          "favorites": [
            {
              "emoji": {
                "type": "unicode",
                "value": "👍"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "❤️"
              },
              "availability": "available"
            }
          ]
        }
      },
      "note": "identical content with the current revision is a no-op as well"
    }
  ]
}
