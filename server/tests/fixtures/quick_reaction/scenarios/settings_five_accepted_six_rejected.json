{
  "name": "settings_five_accepted_six_rejected",
  "description": "Five favorites are the maximum; six are rejected with a field violation and the stored settings stay untouched.",
  "setup": {
    "emoji": {
      "blobcat": {
        "shortcode": "blobcat",
        "image_url": "https://emoji.shuttlepub.example/blobcat.png",
        "availability": "available"
      },
      "oldcat": {
        "shortcode": "oldcat",
        "availability": "unavailable",
        "reason": "deleted"
      },
      "offcat": {
        "shortcode": "offcat",
        "availability": "unavailable",
        "reason": "disabled"
      }
    },
    "settings": {
      "revision": 0,
      "favorites": []
    },
    "reaction": null
  },
  "steps": [
    {
      "operation": "putQuickReactionSettings",
      "body": {
        "expected_revision": 0,
        "favorites": [
          {
            "type": "unicode",
            "value": "👍"
          },
          {
            "type": "unicode",
            "value": "❤️"
          },
          {
            "type": "unicode",
            "value": "🎉"
          },
          {
            "type": "unicode",
            "value": "🔥"
          },
          {
            "type": "custom",
            "id": "blobcat"
          }
        ]
      },
      "expect": {
        "status": 200,
        "body": {
          "revision": 1,
          "favorites": [
            {
              "emoji": {
                "type": "unicode",
                "value": "👍"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "❤️"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "🎉"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "🔥"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "custom",
                "id": "blobcat"
              },
              "availability": "available",
              "shortcode": "blobcat",
              "image_url": "https://emoji.shuttlepub.example/blobcat.png"
            }
          ]
        }
      }
    },
    {
      "operation": "putQuickReactionSettings",
      "body": {
        "expected_revision": 1,
        "favorites": [
          {
            "type": "unicode",
            "value": "👍"
          },
          {
            "type": "unicode",
            "value": "❤️"
          },
          {
            "type": "unicode",
            "value": "🎉"
          },
          {
            "type": "unicode",
            "value": "🔥"
          },
          {
            "type": "custom",
            "id": "blobcat"
          },
          {
            "type": "unicode",
            "value": "👀"
          }
        ]
      },
      "expect": {
        "status": 400,
        "body": {
          "code": "invalid_request",
          "message": "the request failed validation",
          "details": [
            {
              "field": "/favorites",
              "message": "at most 5 favorites are allowed"
            }
          ]
        }
      }
    },
    {
      "operation": "getQuickReactionSettings",
      "expect": {
        "status": 200,
        "body": {
          "revision": 1,
          "favorites": [
            {
              "emoji": {
                "type": "unicode",
                "value": "👍"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "❤️"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "🎉"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "unicode",
                "value": "🔥"
              },
              "availability": "available"
            },
            {
              "emoji": {
                "type": "custom",
                "id": "blobcat"
              },
              "availability": "available",
              "shortcode": "blobcat",
              "image_url": "https://emoji.shuttlepub.example/blobcat.png"
            }
          ]
        }
      }
    }
  ]
}
