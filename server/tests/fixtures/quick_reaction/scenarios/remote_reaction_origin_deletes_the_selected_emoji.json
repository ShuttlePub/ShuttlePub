{
  "name": "remote_reaction_origin_deletes_the_selected_emoji",
  "description": "The origin deletes (and the local image expires for) the external emoji the Profile selected: it stays available with image_state missing, so repeating it is the 200 no-op, DELETE works, and while another person still carries the chip it can be selected again (no 422 emoji_unavailable).",
  "setup": {
    "emoji": {
      "blobcat": {
        "shortcode": "blobcat",
        "image_url": "https://emoji.shuttlepub.example/blobcat.png",
        "availability": "available",
        "image_state": "present",
        "usage": "anywhere"
      },
      "partycat@remote.example": {
        "shortcode": "partycat",
        "image_url": "https://remote.example/emoji/partycat.png",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      },
      "partycat@other.example": {
        "shortcode": "partycat",
        "image_url": "https://other.example/emoji/partycat.png",
        "availability": "available",
        "origin": "other.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      },
      "ghostcat@remote.example": {
        "shortcode": "ghostcat",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "missing",
        "usage": "existing_reaction_only"
      },
      "goneblob@remote.example": {
        "shortcode": "goneblob",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "missing",
        "usage": "existing_reaction_only"
      }
    },
    "settings": {
      "revision": 0,
      "favorites": []
    },
    "reaction": {
      "type": "custom",
      "id": "partycat@remote.example"
    },
    "chips": [
      {
        "type": "custom",
        "id": "partycat@remote.example"
      }
    ]
  },
  "steps": [
    {
      "operation": "getNoteReaction",
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": {
            "emoji": {
              "type": "custom",
              "id": "partycat@remote.example"
            },
            "availability": "available",
            "shortcode": "partycat",
            "image_url": "https://remote.example/emoji/partycat.png",
            "origin": "remote.example",
            "image_state": "present",
            "usage": "existing_reaction_only"
          }
        }
      }
    },
    {
      "mutate_emoji_origin_deleted": {
        "id": "partycat@remote.example"
      }
    },
    {
      "operation": "getNoteReaction",
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": {
            "emoji": {
              "type": "custom",
              "id": "partycat@remote.example"
            },
            "availability": "available",
            "shortcode": "partycat",
            "origin": "remote.example",
            "image_state": "missing",
            "usage": "existing_reaction_only"
          }
        }
      }
    },
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "custom",
          "id": "partycat@remote.example"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": {
            "emoji": {
              "type": "custom",
              "id": "partycat@remote.example"
            },
            "availability": "available",
            "shortcode": "partycat",
            "origin": "remote.example",
            "image_state": "missing",
            "usage": "existing_reaction_only"
          }
        }
      }
    },
    {
      "operation": "deleteNoteReaction",
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": null
        }
      }
    },
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "custom",
          "id": "partycat@remote.example"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": {
            "emoji": {
              "type": "custom",
              "id": "partycat@remote.example"
            },
            "availability": "available",
            "shortcode": "partycat",
            "origin": "remote.example",
            "image_state": "missing",
            "usage": "existing_reaction_only"
          }
        }
      }
    }
  ]
}
