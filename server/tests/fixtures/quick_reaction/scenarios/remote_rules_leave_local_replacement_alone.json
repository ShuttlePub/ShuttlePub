{
  "name": "remote_rules_leave_local_replacement_alone",
  "description": "Unicode and same-server custom emoji keep the S3 replacement semantics; external-emoji rules do not apply to them.",
  "setup": {
    "emoji": {
      "blobcat": {
        "shortcode": "blobcat",
        "image_url": "https://emoji.shuttlepub.example/blobcat.png",
        "availability": "available",
        "image_state": "present",
        "usage": "anywhere"
      },
      "partycat@remote.example": {
        "shortcode": "partycat",
        "image_url": "https://remote.example/emoji/partycat.png",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      },
      "partycat@other.example": {
        "shortcode": "partycat",
        "image_url": "https://other.example/emoji/partycat.png",
        "availability": "available",
        "origin": "other.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      },
      "ghostcat@remote.example": {
        "shortcode": "ghostcat",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "missing",
        "usage": "existing_reaction_only"
      },
      "goneblob@remote.example": {
        "shortcode": "goneblob",
        "availability": "unavailable",
        "reason": "deleted",
        "origin": "remote.example",
        "image_state": "missing",
        "usage": "existing_reaction_only"
      }
    },
    "settings": {
      "revision": 0,
      "favorites": []
    },
    "reaction": {
      "type": "unicode",
      "value": "👍"
    },
    "chips": []
  },
  "steps": [
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "custom",
          "id": "blobcat"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": {
            "emoji": {
              "type": "custom",
              "id": "blobcat"
            },
            "availability": "available",
            "shortcode": "blobcat",
            "image_url": "https://emoji.shuttlepub.example/blobcat.png",
            "image_state": "present",
            "usage": "anywhere"
          }
        }
      }
    },
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "unicode",
          "value": "❤️"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": {
            "emoji": {
              "type": "unicode",
              "value": "❤️"
            },
            "availability": "available"
          }
        }
      }
    }
  ]
}
