{
  "name": "remote_reaction_repeat_precedes_chip_rule",
  "description": "The repeat no-op comes before the chip rule: repeating the current external selection is 200 even when nobody else carries the chip.",
  "setup": {
    "emoji": {
      "blobcat": {
        "shortcode": "blobcat",
        "image_url": "https://emoji.shuttlepub.example/blobcat.png",
        "availability": "available",
        "image_state": "present",
        "usage": "anywhere"
      },
      "partycat@remote.example": {
        "shortcode": "partycat",
        "image_url": "https://remote.example/emoji/partycat.png",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      },
      "partycat@other.example": {
        "shortcode": "partycat",
        "image_url": "https://other.example/emoji/partycat.png",
        "availability": "available",
        "origin": "other.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      },
      "ghostcat@remote.example": {
        "shortcode": "ghostcat",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "missing",
        "usage": "existing_reaction_only"
      },
      "goneblob@remote.example": {
        "shortcode": "goneblob",
        "availability": "unavailable",
        "reason": "deleted",
        "origin": "remote.example",
        "image_state": "missing",
        "usage": "existing_reaction_only"
      }
    },
    "settings": {
      "revision": 0,
      "favorites": []
    },
    "reaction": {
      "type": "custom",
      "id": "partycat@remote.example"
    },
    "chips": []
  },
  "steps": [
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "custom",
          "id": "partycat@remote.example"
        }
      },
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": {
            "emoji": {
              "type": "custom",
              "id": "partycat@remote.example"
            },
            "availability": "available",
            "shortcode": "partycat",
            "image_url": "https://remote.example/emoji/partycat.png",
            "origin": "remote.example",
            "image_state": "present",
            "usage": "existing_reaction_only"
          }
        }
      }
    },
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "custom",
          "id": "ghostcat@remote.example"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "emoji_usage_not_allowed",
          "message": "an external emoji can only be used from an existing reaction",
          "details": [
            {
              "field": "/emoji",
              "message": "an external emoji can only be used from an existing reaction"
            }
          ]
        }
      }
    }
  ]
}
