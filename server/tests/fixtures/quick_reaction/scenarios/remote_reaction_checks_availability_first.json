{
  "name": "remote_reaction_checks_availability_first",
  "description": "Order of checks: availability (422 emoji_unavailable) comes before the repeat no-op and before the chip rule; DELETE never depends on it. An external emoji this server disabled is unavailable; one deleted at its origin (goneblob) is not: it passes availability and meets the chip rule instead.",
  "setup": {
    "emoji": {
      "blobcat": {
        "shortcode": "blobcat",
        "image_url": "https://emoji.shuttlepub.example/blobcat.png",
        "availability": "available",
        "image_state": "present",
        "usage": "anywhere"
      },
      "partycat@remote.example": {
        "shortcode": "partycat",
        "image_url": "https://remote.example/emoji/partycat.png",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      },
      "partycat@other.example": {
        "shortcode": "partycat",
        "image_url": "https://other.example/emoji/partycat.png",
        "availability": "available",
        "origin": "other.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      },
      "ghostcat@remote.example": {
        "shortcode": "ghostcat",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "missing",
        "usage": "existing_reaction_only"
      },
      "goneblob@remote.example": {
        "shortcode": "goneblob",
        "availability": "available",
        "origin": "remote.example",
        "image_state": "missing",
        "usage": "existing_reaction_only"
      },
      "offblob@remote.example": {
        "shortcode": "offblob",
        "image_url": "https://remote.example/emoji/offblob.png",
        "availability": "unavailable",
        "reason": "disabled",
        "origin": "remote.example",
        "image_state": "present",
        "usage": "existing_reaction_only"
      }
    },
    "settings": {
      "revision": 0,
      "favorites": []
    },
    "reaction": {
      "type": "custom",
      "id": "offblob@remote.example"
    },
    "chips": []
  },
  "steps": [
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "custom",
          "id": "offblob@remote.example"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "emoji_unavailable",
          "message": "an emoji in the request is unavailable",
          "details": [
            {
              "field": "/emoji",
              "message": "emoji is unavailable"
            }
          ]
        }
      }
    },
    {
      "operation": "getNoteReaction",
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": {
            "emoji": {
              "type": "custom",
              "id": "offblob@remote.example"
            },
            "availability": "unavailable",
            "unavailable_reason": "disabled",
            "shortcode": "offblob",
            "image_url": "https://remote.example/emoji/offblob.png",
            "origin": "remote.example",
            "image_state": "present",
            "usage": "existing_reaction_only"
          }
        }
      }
    },
    {
      "operation": "deleteNoteReaction",
      "expect": {
        "status": 200,
        "body": {
          "note_id": "0f0a5d3e-8f3c-4c53-9b64-3f5f8f0f2a11",
          "emoji": null
        }
      }
    },
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "custom",
          "id": "offblob@remote.example"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "emoji_unavailable",
          "message": "an emoji in the request is unavailable",
          "details": [
            {
              "field": "/emoji",
              "message": "emoji is unavailable"
            }
          ]
        }
      }
    },
    {
      "operation": "putNoteReaction",
      "body": {
        "emoji": {
          "type": "custom",
          "id": "goneblob@remote.example"
        }
      },
      "expect": {
        "status": 422,
        "body": {
          "code": "emoji_usage_not_allowed",
          "message": "an external emoji can only be used from an existing reaction",
          "details": [
            {
              "field": "/emoji",
              "message": "an external emoji can only be used from an existing reaction"
            }
          ]
        }
      }
    }
  ]
}
